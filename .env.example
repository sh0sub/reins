# Copy to .env and fill in. Never commit .env.

# --- Database (SQLite via libsql; on Render a persistent disk: file:/var/data/reins.db, see docs/deploy.md) ---
DATABASE_URL=file:./.local/reins.db

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
# PAYPAL_ENV=fake runs everything against the in-process fake client (no network).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you register the webhook URL in the sandbox app
PAYPAL_WEBHOOK_ID=
# Payment strategy: vaulted | supervised | treasury
PAYPAL_PAYMENT_MODE=supervised
# Sandbox personal (buyer) account email, used by spikes and Treasury payouts
PAYPAL_SANDBOX_BUYER_EMAIL=
# Second sandbox business account email (spike #29 payee.email_address)
PAYPAL_SANDBOX_PAYEE_EMAIL=
# Shown as the connected merchant for "Use demo merchant"
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# 1 = add stored_credential{MERCHANT,UNSCHEDULED,SUBSEQUENT} to vault_id orders (spike #28 decides)
PAYPAL_VAULT_STORED_CREDENTIAL=0
# Payee email for Treasury mode payouts (M8')
TREASURY_PAYEE_EMAIL=
# Public base URL of apps/web (return_url / cancel_url, webhook URL, ngrok URL in dev). On Render it defaults to RENDER_EXTERNAL_URL
PUBLIC_BASE_URL=http://localhost:3000

# --- Claude API (policy auditor). Empty -> deterministic mock auditor ---
ANTHROPIC_API_KEY=

# --- Telegram (BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ReinsApproveBot
# Secret token for POST /api/telegram/webhook (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# webhook | polling | off. Default: webhook when PUBLIC_BASE_URL is https, long polling otherwise (local dev)
TELEGRAM_MODE=
# 1 = log Bot API sends/edits (first line of the card only; never chat ids or tokens)
REINS_TELEGRAM_LOG=0
# 1 = keep Node's IPv6/IPv4 happy-eyeballs. Default off because a broken IPv6 route times out api.telegram.org
REINS_NET_AUTOSELECT=0

# --- Channel3 (spike #31, demo agent product search) ---
CHANNEL3_API_KEY=

# --- Reins ---
# Optional: if set, dashboard/admin API routes require "Authorization: Bearer <token>" or x-reins-admin header
REINS_ADMIN_TOKEN=
# Bearer secret for POST /api/cron/reconcile (Render Cron). Unset = route disabled. render.yaml generates it
REINS_CRON_SECRET=
# Minutes before a pending_human request expires
REINS_APPROVAL_TTL_MINUTES=30
# How often the expiry timer sweeps pending approvals (ms)
REINS_EXPIRY_SWEEP_MS=60000
# 0 = skip the auditor's advisory explanation after a hard-rule DENY
REINS_EXPLAIN_DENIALS=1
# MCP server: Reins web API base URL and the agent key (stdio mode). MCP HTTP on Render uses REINS_API_HOSTPORT instead
REINS_API_URL=http://localhost:3000
REINS_API_KEY=
# DevOps cron agent: MCP Streamable HTTP URL (or REINS_MCP_HOSTPORT on Render). Empty = spawn the stdio server
REINS_MCP_URL=
# S3 late-night pattern: local quiet hours "start-end" (end exclusive) or "off"; zone defaults to the server's
REINS_QUIET_HOURS=0-6
# Public demo: refuse visitor PayPal credentials on /api/paypal/connect (demo merchant only)
# REINS_PUBLIC_DEMO=1
REINS_TIMEZONE=Asia/Seoul
